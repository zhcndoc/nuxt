FROM node:24-bookworm AS builder

WORKDIR /app

ENV CI=true

RUN corepack enable pnpm

COPY . .

RUN pnpm install --frozen-lockfile

RUN --mount=type=secret,id=NUXT_GITHUB_TOKEN,env=NUXT_GITHUB_TOKEN pnpm run build

FROM node:24-bookworm-slim

WORKDIR /app

RUN mkdir -p .data/db

ENV NODE_ENV=production \
    NITRO_HOST=0.0.0.0 \
    PORT=8080

COPY --from=builder /app/.output ./.output

COPY --from=builder /app/node_modules/.pnpm/@libsql+linux-*-gnu@*/node_modules/@libsql/ ./.output/server/node_modules/@libsql/

EXPOSE 8080

CMD ["node", ".output/server/index.mjs"]
